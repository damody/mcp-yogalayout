{
  "typography": {
    "title":    { "family": "Inter", "size_pt": 28, "line_height": 1.05, "weight": 700 },
    "subtitle": { "family": "Inter", "size_pt": 14, "line_height": 1.15, "weight": 500 },
    "h2":       { "family": "Inter", "size_pt": 16, "line_height": 1.15, "weight": 700 },
    "body":     { "family": "Inter", "size_pt": 11, "line_height": 1.25, "weight": 400 },
    "caption":  { "family": "Inter", "size_pt": 10, "line_height": 1.20, "weight": 400 },
    "mono":     { "family": "JetBrains Mono", "size_pt": 10, "line_height": 1.20, "weight": 400 }
  },
  "spacing_pt": { "xs": 2, "sm": 4, "md": 6, "lg": 8, "xl": 12, "2xl": 16 },
  "policy": {
    "page_padding": "xl",
    "min_font_pt": 10,
    "min_image_box_pt": { "w": 180, "h": 120 },
    "figure_constraints": {
      "min_width_pt": 180,
      "min_height_pt": 50,
      "max_height_pt": 80,
      "width_ratio": 0.45
    },
    "two_col_when": { "has_image_or_diagram": true, "has_bullets_or_table": true },
    "two_col_split": [0.58, 0.42]
  }
}
